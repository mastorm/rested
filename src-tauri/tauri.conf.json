{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rested",
  "version": "0.1.0",
  "identifier": "dev.rested.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Rested",
      "width": 1040,
      "height": 880,
      "minWidth": 680,
      "minHeight": 640,
      "center": true,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true,
      "theme": "Dark",
      "backgroundColor": "#111b21"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Earn your adventures",
    "longDescription": "Study for a minute. Earn two minutes in Azeroth. Rested balances focus and play with two simple timers and a persistent playtime reserve.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
